// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ROLE {
  SUPER_ADMIN
  COORDINATOR
  DOCTOR
  HEAD_NURSE
  NURSE
  PRACTICAL_NURSE
}



enum ResidentStatus {
  ACTIVE
  DISCHARGED
}


enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// -----------------------------------------------------------------------------
// ORGANIZATION & IDENTITY
// -----------------------------------------------------------------------------

model CareHomeAgency {
  id            Int            @id @default(autoincrement())
  name          String
  address       String?
  users         User[]
  residents     Resident[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("care_home_agencies")
}

model User {
  userId       String  @id @default(cuid()) @map("user_id")
  email        String  @unique
  passwordHash String  @map("password_hash")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  roles        ROLE[]
  active       Boolean @default(true)

  agencyId Int?            @map("agency_id")
  agency   CareHomeAgency? @relation(fields: [agencyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([agencyId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// PROFILES (CAREGIVER & STAFF)
// -----------------------------------------------------------------------------

model Staff {
  id     String @id @map("user_id")

  firstName String
  lastName String
  email String @unique
  role ROLE
  birthDate DateTime? @map("birth_date")

  phone          String
  employmentType EmploymentType @map("employment_type")
  hireDate       DateTime       @map("hire_date")

  department String?
  title      String?

  certifications Certification[]
  assignedTasks  CareTask[]          @relation("CaregiverAssignments")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staffs")
}

model Certification {
  id          String    @id @default(cuid())
  name        String
  issuer      String
  validFrom   DateTime  @map("valid_from")
  validTo     DateTime? @map("valid_to")
  staffId String    @map("staff_id")
  staff   Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("certifications")
}


// -----------------------------------------------------------------------------
// RESIDENTS
// -----------------------------------------------------------------------------

enum MobilityLevel {
  INDEPENDENT
  ASSISTED
  MEMORY
}


model Resident {
  residentId String         @id @default(cuid()) @map("resident_id")
  mrn        String         @unique
  firstName  String         @map("first_name")
  lastName   String         @map("last_name")
  ssn        String         @unique
  birthDate  DateTime       @map("birth_date")
  gender     Gender
  status     ResidentStatus @default(ACTIVE)
  room          String? 

  mobilityLevel MobilityLevel

  agencyId Int            @map("care_home_agency_id")
  agency   CareHomeAgency @relation(fields: [agencyId], references: [id])

  
  tasks             CareTask[]                   @relation("ResidentAssignments")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("residents")
}


// -----------------------------------------------------------------------------
// CARE PLAN & UNIFIED TASK PIPELINE
// -----------------------------------------------------------------------------


model CareTask {
  id         String        @id
  title      String
 
  residentId String   @map("resident_id")
  resident   Resident @relation("ResidentAssignments", fields: [residentId], references: [residentId])

  description         String
  // The foreign key field
  assignedStaffId String?    @map("assigned_staff_id")
  // The relation field (points to the Caregiver model)
  assignedStaff   Staff? @relation("CaregiverAssignments", fields: [assignedStaffId], references: [id])

  status   String
  priority String  


  dueAt       DateTime  @map("due_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  completionNote String? @map("completion_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([residentId])
  @@index([status])
  @@map("care_tasks")
}
